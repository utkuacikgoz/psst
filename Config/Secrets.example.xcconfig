// Copy to Config/Secrets.xcconfig. Never commit that file.

// Host only, without https:// (xcconfig reads // as a comment).
PSST_SUPABASE_HOST = your-project-ref.supabase.co
// The project's anon (publishable) key. It identifies the app, not a user;
// the database's row-level security does the authorizing.
PSST_SUPABASE_ANON_KEY = your-anon-key

// Push notifications need your Apple team, a bundle ID you own, and the
// Push Notifications capability. APNS_BUNDLE_ID on the server must match.
DEVELOPMENT_TEAM = YOURTEAMID
PSST_APP_BUNDLE_ID = com.example.psst
CODE_SIGN_ENTITLEMENTS = Config/Psst.entitlements
